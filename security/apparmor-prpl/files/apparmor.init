#!/bin/sh /etc/rc.common

START=5
USE_PROCD=1

. /lib/functions/apparmor.sh

restart() {
	apparmor_restart
}

start_service() {
        if [ -f "/tmp/apparmor.ready" ];then
            rm /tmp/apparmor.ready
        fi
	apparmor_start
        touch /tmp/apparmor.ready
}

stop_service() {
	apparmor_stop
}

reload_service() {
	apparmor_reload
}
