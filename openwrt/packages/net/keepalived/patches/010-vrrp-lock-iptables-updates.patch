From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrey Erokhin <a.erokhin@inango-systems.com>
Date: Tue, 21 Jul 2026 00:00:00 +0500
Subject: [PATCH] keepalived: lock xtables before VRRP iptables updates

keepalived updates VRRP firewall rules through libiptc, which does not
take the userspace xtables lock by itself. Concurrent updates from
iptables or prpl Firewall can therefore race with keepalived commits.

Add an optional, default-enabled configure switch for taking the
xtables.lock file before modifying iptables rules. This keeps the lock
scoped to each iptables update transaction and releases it on close.

References: FEAT-342
Upstream-Status: Pending
Signed-off-by: Andrey Erokhin <a.erokhin@inango-systems.com>
---
 configure.ac                    |   12 +++++
 keepalived/vrrp/vrrp_iptables.c |   89 ++++++++++++++++++++++++++++++++++++++--
 2 files changed, 97 insertions(+), 4 deletions(-)

--- a/configure.ac
+++ b/configure.ac
@@ -211,6 +211,8 @@
 AC_ARG_ENABLE(iptables,
   [AS_HELP_STRING([--disable-iptables], [compile without iptables support])],
   [], [IPTABLES_SILENT=Yes])
+AC_ARG_ENABLE(xtables-lock,
+  [AS_HELP_STRING([--disable-xtables-lock], [compile without xtables.lock synchronization for iptables updates])])
 AC_ARG_ENABLE(libiptc-dynamic,
   [AS_HELP_STRING([--enable-libiptc-dynamic], [compile with libiptc dynamically linked])])
 AC_ARG_ENABLE(libipset-dynamic,
@@ -456,11 +458,13 @@
     AS_IF([test .$enable_linkbeat != .], [AC_MSG_ERROR([disable-linkbeat requires vrrp])])
     AS_IF([test .$enable_bfd != .], [AC_MSG_ERROR([enable-bfd requires vrrp])])
     AS_IF([test .$enable_iptables != .no], [AC_MSG_ERROR([disable-iptables requires vrrp])])
+    AS_IF([test .$enable_xtables_lock != .], [AC_MSG_ERROR([disable-xtables-lock requires vrrp and iptables])])
     AS_IF([test .$enable_track_process != .], [AC_MSG_ERROR([disable-track-process requires vrrp])])
     AS_IF([test .$enable_network_timestamp != .], [AC_MSG_ERROR([enable-network-timestamp requires vrrp])])
     AS_IF([test .$enable_netlink_timers != .], [AC_MSG_ERROR([enable-netlink-timers requires vrrp])])
   )
 AS_IF([test .$enable_iptables = .no],
+    AS_IF([test .$enable_xtables_lock != .], [AC_MSG_ERROR([disable-xtables-lock requires vrrp and iptables])])
     AS_IF([test .$enable_libipset != .], [AC_MSG_ERROR([disable-libipset requires vrrp and iptables])])
   )
 AS_IF([test .$enable_libipset = .no],
@@ -1645,6 +1649,7 @@
 dnl ----[Check for iptables libraries]----
 USE_IPTABLES=No
 USE_LIBIPSET=No
+USE_XTABLES_LOCK=No
 AS_IF([test .$enable_iptables != .no],
   [
     USE_IPTABLES=Yes
@@ -1800,6 +1805,12 @@
     if test $USE_IPTABLES = Yes; then
       AC_DEFINE([_WITH_IPTABLES_], [ 1 ], [Define to 1 if want iptables support])
       add_system_opt([IPTABLES])
+      AS_IF([test .${enable_xtables_lock} != .no],
+        [
+          USE_XTABLES_LOCK=Yes
+          AC_DEFINE([_USE_XTABLES_LOCK_], [ 1 ], [Define to 1 if using xtables.lock synchronization for iptables updates])
+          add_system_opt([XTABLES_LOCK])
+        ])
     fi
   ])
 AM_CONDITIONAL([LIBIPSET], [test $USE_LIBIPSET = Yes])
@@ -3259,6 +3270,7 @@
 echo "Use iptables             : ${USE_IPTABLES}"
 if test .$USE_IPTABLES = .Yes; then
   echo "Use libipset             : ${USE_LIBIPSET}"
+  echo "Use xtables lock         : ${USE_XTABLES_LOCK}"
 fi
 echo "Use nftables             : ${USE_NFTABLES}"
 echo "init type                : ${INIT_TYPE}"
--- a/keepalived/vrrp/vrrp_iptables.c
+++ b/keepalived/vrrp/vrrp_iptables.c
@@ -23,6 +23,13 @@
 #include "config.h"
 
 #include <errno.h>
+#ifdef _USE_XTABLES_LOCK_
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
 #include <sys/stat.h>
 #include <sys/vfs.h>
 #include <linux/magic.h>
@@ -82,6 +89,9 @@
 #ifdef _HAVE_LIBIPSET_
 	struct ipset_session* session;
 #endif
+#ifdef _USE_XTABLES_LOCK_
+	int lock_fd;
+#endif
 	int	cmd;
 } ;
 
@@ -92,10 +102,9 @@
 static init_state_t igmp_setup[2];
 #endif
 
-/* The way iptables appears to work is that when we do an iptc_init, we get a
- * snapshot of the iptables table, which internally includes an update number.
- * When iptc_commit is called, it checks the update number, and if it has been
- * updated by someone else, returns EAGAIN.
+/* The way iptables works is that when we do an iptc_init, we get a snapshot
+ * of the iptables table. If the table entry count changes before iptc_commit,
+ * the kernel can return EAGAIN.
  *
  * Note: iptc_commit only needs to be called if we are changing something. In
  *   all cases though, iptc_free must be called.
@@ -225,11 +234,70 @@
 #endif
 #endif
 
+#ifdef _USE_XTABLES_LOCK_
+static const char *
+xtables_lockfile_name(void)
+{
+	const char *lock_file;
+
+	lock_file = getenv("XTABLES_LOCKFILE");
+	if (lock_file && lock_file[0])
+		return lock_file;
+
+	if (access("/run/xtables.lock", F_OK) == 0)
+		return "/run/xtables.lock";
+
+	return "/var/run/xtables.lock";
+}
+
+static bool
+xtables_lock(int *lock_fd)
+{
+	const char *lock_file = xtables_lockfile_name();
+	int fd;
+
+	fd = open(lock_file, O_RDONLY | O_CREAT, 0600);
+	if (fd < 0) {
+		log_message(LOG_INFO, "Cannot open iptables lock file %s: %s",
+			    lock_file, strerror(errno));
+		return false;
+	}
+
+	while (flock(fd, LOCK_EX) < 0) {
+		if (errno == EINTR)
+			continue;
+
+		log_message(LOG_INFO, "Cannot lock iptables lock file %s: %s",
+			    lock_file, strerror(errno));
+		close(fd);
+		return false;
+	}
+
+	*lock_fd = fd;
+	return true;
+}
+
+static void
+xtables_unlock(int lock_fd)
+{
+	if (lock_fd >= 0)
+		close(lock_fd);
+}
+#endif
+
 static struct ipt_handle*
 iptables_open(int cmd)
 {
 	struct ipt_handle *h = MALLOC(sizeof(struct ipt_handle));
 
+#ifdef _USE_XTABLES_LOCK_
+	h->lock_fd = -1;
+	if (!xtables_lock(&h->lock_fd)) {
+		FREE(h);
+		return NULL;
+	}
+#endif
+
 	h->cmd = cmd;
 
 	return h;
@@ -262,6 +330,9 @@
 		ipset_session_end(h->session);
 #endif
 
+#ifdef _USE_XTABLES_LOCK_
+	xtables_unlock(h->lock_fd);
+#endif
 	FREE(h);
 
 	return res;
@@ -441,6 +512,9 @@
 		return;
 
 	h = iptables_open(IPADDRESS_DEL);
+	if (!h)
+		return;
+
 	family = AF_INET;
 	do {
 		if (vips_setup[family != AF_INET] == INIT_SUCCESS)
@@ -457,6 +531,9 @@
 
 	/* The sets must not be in use when the ipset session starts */
 	h = iptables_open(IPADDRESS_DEL);
+	if (!h)
+		return;
+
 	family = AF_INET;
 	do {
 		if (vips_setup[family != AF_INET] == INIT_SUCCESS) {
@@ -526,6 +603,8 @@
 
 	do {
 		h = iptables_open(cmd);
+		if (!h)
+			return;
 
 		if (ip_list1 && !list_empty(ip_list1))
 			handle_iptable_vip_list(h, ip_list1, cmd, force);
@@ -642,6 +721,8 @@
 
 	do {
 		h = iptables_open(cmd);
+		if (!h)
+			return;
 
 		handle_iptable_rule_for_igmp(ifp->ifname, cmd, family, h);
 
