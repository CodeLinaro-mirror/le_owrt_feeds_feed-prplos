ifneq ($(PKG_VERSION).$(PKG_RELEASE),2.8.2.64)
  $(error upstream ddns-scripts was updated, please update patched scripts)
endif

define Package/ddns-scripts/install-append
	$(THISDIR)/scripts/patch-https-http-fallback.sh $$(1)
	$(THISDIR)/scripts/patch-network-get-device.sh $$(1)
	$(THISDIR)/scripts/patch-ddns-get-device-function.sh $$(1)
	$(THISDIR)/scripts/patch-nxdomain-verify-host.sh $$(1)
	$(THISDIR)/scripts/patch-nxdomain-get-registered-ip.sh $$(1)
endef

$(call append,Package/ddns-scripts/install,$(newline)$(Package/ddns-scripts/install-append))
