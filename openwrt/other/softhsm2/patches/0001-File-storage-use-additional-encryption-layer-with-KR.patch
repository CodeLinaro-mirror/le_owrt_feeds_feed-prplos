+// Decrypt data with a KRS managed key
+bool SecureDataManager::decrypt_with_krs(const ByteString& encrypted, ByteString& plaintext)
+{
+	struct kcapi_handle *handle = NULL;
+
+	const char * keydescr = getenv("SOFTHSM2_CIPHER_KRS_KEY_DESCR");
+	if (keydescr == NULL)
+	{
+		INFO_MSG("KRS key description not found, decrypt with KRS disabled");
+		// Decrypt with KRS disabled, return encrypted string as is.
+		plaintext = ByteString(encrypted.const_byte_str(), encrypted.size());
+		return true;
+	}
+
+	long keyserial = keyctl_search(KEY_SPEC_USER_KEYRING, "logon", keydescr, 0);
+	if (keyserial < 0)
+	{
+		ERROR_MSG("Could not get KRS key serial");
+		return false;
+	}
+
+	if (kcapi_cipher_init(&handle, "cbc(aes-generic)", 0)) return false;
+	if (kcapi_cipher_setkey_by_key_serial(handle, keyserial))
+	{
+		ERROR_MSG("Could not get KRS key with serial");
+		kcapi_cipher_destroy(handle);
+		return false;
+	}
+
+	// Take the IV from the input data
+	ByteString IV = encrypted.substr(0, kcapi_cipher_blocksize(handle));
+
+	if (IV.size() != kcapi_cipher_blocksize(handle))
+	{
+		ERROR_MSG("Invalid IV in encrypted data");
+		kcapi_cipher_destroy(handle);
+		return false;
+	}
+
+	// Setup decrypt operation input data in "plaintext" buffer.
+	plaintext.wipe(encrypted.size() - IV.size());
+	memcpy(plaintext.byte_str(), encrypted.const_byte_str() + kcapi_cipher_blocksize(handle), plaintext.size());
+
+	ssize_t out_size = kcapi_cipher_decrypt(
+		handle,
+		plaintext.byte_str(),
+		plaintext.size(),
+		IV.const_byte_str(),
+		plaintext.byte_str(),
+		plaintext.size(),
+		0);
+	if (out_size < 0)
+	{
+		ERROR_MSG("Kernel decrypt operation failed");
+		kcapi_cipher_destroy(handle);
+		return false;
+	}
+
+	// Remove pkcs#7 padding if any
+	uint8_t last_byte = plaintext[plaintext.size() - 1];
+	bool padded = false;
+	if (last_byte < kcapi_cipher_blocksize(handle))
+	{
+		for (size_t i=plaintext.size()-last_byte-1; i<plaintext.size(); i++)
+		{
+			if (plaintext[i] != last_byte) break;
+		}
+		padded = true;
+	}
+	if (padded)
+	{
+		plaintext.resize(plaintext.size() - last_byte);
+	}
+
+	kcapi_cipher_destroy(handle);
+	return true;
+
+}
