+// Encrypt data with a KRS managed key
+bool SecureDataManager::encrypt_with_krs(const ByteString& plaintext, ByteString& encrypted)
+{
+	struct kcapi_handle *handle = NULL;
+	ByteString IV;
+
+	const char * keydescr = getenv("SOFTHSM2_CIPHER_KRS_KEY_DESCR");
+	if (keydescr == NULL)
+	{
+		INFO_MSG("KRS key description not found, encrypt with KRS disabled");
+		// Encrypt with KRS disabled, return plaintext string as is.
+		encrypted = ByteString(plaintext.const_byte_str(), plaintext.size());
+		return true;
+	}
+
+	long keyserial = keyctl_search(KEY_SPEC_USER_KEYRING, "logon", keydescr, 0);
+	if (keyserial < 0)
+	{
+		ERROR_MSG("Could not get KRS key serial");
+		return false;
+	}
+
+	if (kcapi_cipher_init(&handle, "cbc(aes-generic)", 0)) return false;
+	if (kcapi_cipher_setkey_by_key_serial(handle, keyserial))
+	{
+		ERROR_MSG("Could not get KRS key with serial");
+		kcapi_cipher_destroy(handle);
+		return false;
+	}
+
+	if (!rng->generateRandom(IV, kcapi_cipher_ivsize(handle))) return false;
+
+	// Setup encrypt operation in the "encrypted" buffer, and pad data with pkcs#7
+	size_t blocksize = kcapi_cipher_blocksize(handle);
+	size_t aligned_size = ((plaintext.size() + blocksize - 1) / blocksize) * blocksize;
+	size_t pad_size = aligned_size - plaintext.size();
+	encrypted.wipe(aligned_size);
+	memcpy(encrypted.byte_str(), plaintext.const_byte_str(), plaintext.size());
+	memset(&encrypted[plaintext.size()], (int) pad_size, pad_size);
+
+	ssize_t out_size = kcapi_cipher_encrypt(
+		handle,
+		encrypted.byte_str(),
+		encrypted.size(),
+		IV.const_byte_str(),
+		encrypted.byte_str(),
+		encrypted.size(),
+		0);
+	if (out_size < 0)
+	{
+		ERROR_MSG("Kernel encrypt operation failed");
+		kcapi_cipher_destroy(handle);
+		return false;
+	}
+
+	// Add IV to output data
+	encrypted = IV + encrypted;
+
+	kcapi_cipher_destroy(handle);
+	return true;
+}
