+static BOOL auth_timestamp(uint32_t *timestamp) {
+        uintmax_t seconds = (uintmax_t) repo.systemClock.tv_sec;
+
+        if (repo.systemClock.tv_sec < 0 || seconds > UINT32_MAX) {
+                char message[] = "ERROR: Authentication timestamp outside supported 32-bit range\n";
+                send_proc(errConn, message, sizeof(message) - 1);
+                return FALSE;
+        }
+        *timestamp = (uint32_t) seconds;
+        return TRUE;
+}
