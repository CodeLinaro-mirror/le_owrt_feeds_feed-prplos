config PACKAGE_tr181-radsecproxy
    tristate
    select SAH_AMX_TR181_RADSECPROXY

if PACKAGE_tr181-radsecproxy

menu "Select tr181-radsecproxy build options"

    depends on PACKAGE_tr181-radsecproxy

config SAH_AMX_TR181_RADSECPROXY
    bool "Build a tr181-radsecproxy plugin"
    default y

config SAH_AMX_TR181_RADSECPROXY_ORDER
    int "Start up order for the tr181-radsecproxy plugin"
    default 25

config SAH_AMX_TR181_RADSECPROXY_RUN_AS_USER
    string "User will be used for the tr181-radsecproxy plugin"
    default "tr181_app"

config SAH_AMX_TR181_RADSECPROXY_RUN_AS_GROUP
    string "Group will be used for the tr181-radsecproxy plugin"
    default "tr181_app"

endmenu
endif
