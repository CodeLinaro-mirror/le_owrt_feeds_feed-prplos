+
+/**
+ * \file plugin_trace.c
+ *
+ * Module providing traceability logging for plugin TR-181 events
+ *
+ */
+
+#include <stdio.h>
+#include <time.h>
+#include <stdarg.h>
+#include <pthread.h>
+
+#include "plugin_trace.h"
+
+//--------------------------------------------------------------------
+// Lock for thread-safe logging
+static pthread_mutex_t trace_lock = PTHREAD_MUTEX_INITIALIZER;
+
+//--------------------------------------------------------------------
+#define PLUGIN_TRACE_FILE "/tmp/obuspa_plugin_trace.log"
+
+/*********************************************************************//**
+**
+** PLUGIN_TRACE_Log
+**
+** Logs an event to the plugin trace log file with timestamp
+** Thread-safe implementation using mutex
+**
+** \param   format - printf-style format string
+** \param   ...    - variable arguments
+**
+** \return  None
+**
+**************************************************************************/
+void PLUGIN_TRACE_Log(const char *format, ...)
+{
+    FILE *log_file;
+    time_t now;
+    struct tm *timeinfo;
+    char timestamp[32];
+    va_list args;
+
+    // Get current time and format timestamp
+    time(&now);
+    timeinfo = localtime(&now);
+    strftime(timestamp, sizeof(timestamp), "[%Y-%m-%d %H:%M:%S]", timeinfo);
+
+    // Acquire lock for thread-safe file access
+    pthread_mutex_lock(&trace_lock);
+
+    // Open log file in append mode
+    log_file = fopen(PLUGIN_TRACE_FILE, "a");
+    if (log_file == NULL)
+    {
+        // If we can't open the file, just return silently
+        pthread_mutex_unlock(&trace_lock);
+        return;
+    }
+
+    // Write timestamp and message
+    fprintf(log_file, "%s ", timestamp);
+    va_start(args, format);
+    vfprintf(log_file, format, args);
+    va_end(args);
+    fprintf(log_file, "\n");
+
+    // Ensure data is written to disk
+    fflush(log_file);
+    fclose(log_file);
+
+    // Release lock
+    pthread_mutex_unlock(&trace_lock);
+}
